# ============================================================
#  羁绊 AI · 环境变量配置示例
#  把此文件复制为 .env，然后填入你自己的配置即可
# ============================================================

# —— 大模型供应商（默认：zhipu，智谱有免费额度）——
# 可选值：zhipu / deepseek / openai / qwen / moonshot / ollama / custom
KIZUNA_LLM_PROVIDER=zhipu

# —— 你的 API Key（必填，否则聊不了）——
# 智谱 Key 获取：https://open.bigmodel.cn/
# DeepSeek Key：https://platform.deepseek.com/
KIZUNA_LLM_API_KEY=你的APIKey写在这里

# —— Base URL（留空用供应商默认）——
# 自定义供应商时必填
KIZUNA_LLM_BASE=

# —— 模型名（留空用供应商默认）——
# 智谱默认 glm-4-flash （中文好、速度快）
# DeepSeek 推荐 deepseek-chat
KIZUNA_LLM_MODEL=

# —— 数据目录（聊天记录、记忆、人格都存在这里）——
# 默认 backend/data
KIZUNA_DATA_DIR=./data

# —— 时区（定时问候按这个来）——
TZ=Asia/Shanghai
